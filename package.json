{
  "name": "@lesfleursdelanuitdev/data-viewer",
  "version": "0.1.0",
  "description": "A list of rows as a table or cards: <lfdln-data-viewer>, a Lit web component.",
  "license": "MIT",
  "author": "Monica Gonsalves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesfleursdelanuitdev/data-viewer.git"
  },
  "homepage": "https://github.com/lesfleursdelanuitdev/data-viewer#readme",
  "bugs": "https://github.com/lesfleursdelanuitdev/data-viewer/issues",
  "keywords": [
    "web-component",
    "custom-element",
    "lit",
    "table",
    "cards",
    "data-table",
    "list"
  ],
  "type": "module",
  "module": "./dist/data-viewer.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/data-viewer.js"
    },
    "./adapters/json": {
      "types": "./dist/types/adapters/json.d.ts",
      "import": "./dist/adapters/json.js"
    },
    "./adapters/pammy": {
      "types": "./dist/types/adapters/pammy.d.ts",
      "import": "./dist/adapters/pammy.js"
    },
    "./standalone": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/data-viewer.standalone.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/*.standalone.js",
    "./dist/data-viewer-*.js",
    "./dist/adapters/*.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --mode standalone && vite build --mode standalone-json && vite build --mode standalone-pammy && npm run types",
    "types": "tsc -p tsconfig.build.json && node scripts/fix-types.mjs",
    "size": "node scripts/size.mjs",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "lit": "3.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
