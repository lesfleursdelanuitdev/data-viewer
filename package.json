{
  "name": "lfdln-components",
  "private": true,
  "description": "The data viewer and the menu, pagination, card, dropdown, search and filter it is built from, one repo.",
  "license": "MIT",
  "author": "Monica Gonsalves",
  "type": "module",
  "workspaces": [
    "packages/menu",
    "packages/select",
    "packages/pagination",
    "packages/card",
    "packages/search",
    "packages/filter",
    "packages/search-filter",
    "packages/data-viewer"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "size": "npm run size --workspaces",
    "e2e": "npm run e2e --workspaces",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e && npm run site:build && npm run site:test",
    "site:build": "node site/build.mjs",
    "site:test": "tsc -p site && playwright test -c site/playwright.config.ts"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "lit": "3.3.3",
    "marked": "18.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
