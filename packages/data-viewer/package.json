{
  "name": "@lesfleursdelanuitdev/data-viewer",
  "version": "0.1.0",
  "description": "A list of rows as a table or cards: <lfdln-data-viewer>, a Lit web component.",
  "license": "MIT",
  "author": "Monica Gonsalves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesfleursdelanuitdev/data-viewer.git",
    "directory": "packages/data-viewer"
  },
  "homepage": "https://github.com/lesfleursdelanuitdev/data-viewer/tree/main/packages/data-viewer#readme",
  "bugs": "https://github.com/lesfleursdelanuitdev/data-viewer/issues",
  "keywords": [
    "web-component",
    "custom-element",
    "lit",
    "table",
    "cards",
    "data-table",
    "list"
  ],
  "type": "module",
  "module": "./dist/data-viewer.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/data-viewer.js"
    },
    "./adapters/json": {
      "types": "./dist/types/adapters/json.d.ts",
      "import": "./dist/adapters/json.js"
    },
    "./adapters/pammy": {
      "types": "./dist/types/adapters/pammy.d.ts",
      "import": "./dist/adapters/pammy.js"
    },
    "./filter-styles/panel": {
      "types": "./dist/types/filter-styles/panel.d.ts",
      "import": "./dist/filter-styles/panel.js"
    },
    "./standalone": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/data-viewer.standalone.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/*.standalone.js",
    "./dist/data-viewer-*.js",
    "./dist/adapters/*.js",
    "./dist/filter-styles/*.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --mode standalone && vite build --mode standalone-json && vite build --mode standalone-pammy && vite build --mode standalone-filter-panel && npm run types && npm run size && npm run no-lit",
    "types": "tsc -p tsconfig.build.json && node ../../scripts/fix-types.mjs",
    "size": "node ../../scripts/size.mjs dist/data-viewer.standalone.js=46080 dist/data-viewer-json.js=3072 dist/data-viewer-pammy.js=3072 dist/data-viewer-filter-panel.js=8192",
    "no-lit": "node --test ../../scripts/no-lit.test.mjs",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "dependencies": {
    "@lesfleursdelanuitdev/menu": "0.1.0",
    "@lesfleursdelanuitdev/pagination": "0.1.0",
    "@lesfleursdelanuitdev/card": "0.1.0",
    "@lesfleursdelanuitdev/search": "0.1.0",
    "@lesfleursdelanuitdev/filter": "0.1.0"
  }
}
