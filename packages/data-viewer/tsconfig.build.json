{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": [],
    "paths": {
      "@lesfleursdelanuitdev/menu": [
        "../menu/dist/types/index.d.ts"
      ],
      "@lesfleursdelanuitdev/pagination": [
        "../pagination/dist/types/index.d.ts"
      ],
      "@lesfleursdelanuitdev/card": [
        "../card/dist/types/index.d.ts"
      ],
      "@lesfleursdelanuitdev/search": [
        "../search/dist/types/index.d.ts"
      ],
      "@lesfleursdelanuitdev/filter": [
        "../filter/dist/types/index.d.ts"
      ],
      "@lesfleursdelanuitdev/filter/*": [
        "../filter/dist/types/*.d.ts"
      ],
      "@lesfleursdelanuitdev/search-filter": [
        "../search-filter/dist/types/index.d.ts"
      ],
      "@lesfleursdelanuitdev/search-filter/*": [
        "../search-filter/dist/types/*.d.ts"
      ]
    }
  },
  "include": [],
  "files": [
    "src/index.ts",
    "src/adapters/json.ts",
    "src/adapters/pammy.ts",
    "src/filter-styles/panel.ts",
    "src/filter-styles/bar.ts",
    "src/filter-styles/rail.ts",
    "src/filter-styles/columns.ts",
    "src/filter-styles/search.ts",
    "src/select/index.ts"
  ]
}
