{
  "name": "@lesfleursdelanuitdev/filter",
  "version": "0.1.0",
  "description": "Filters for any list: <lfdln-filter> (a funnel button, a two-column popover or a phone sheet, draft then Apply) and <lfdln-filter-chips>, Lit web components.",
  "license": "MIT",
  "author": "Monica Gonsalves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesfleursdelanuitdev/data-viewer.git",
    "directory": "packages/filter"
  },
  "homepage": "https://github.com/lesfleursdelanuitdev/data-viewer/tree/main/packages/filter#readme",
  "bugs": "https://github.com/lesfleursdelanuitdev/data-viewer/issues",
  "keywords": [
    "web-component",
    "custom-element",
    "lit",
    "filter",
    "facets",
    "chips"
  ],
  "type": "module",
  "module": "./dist/filter.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/filter.js"
    },
    "./panel": {
      "types": "./dist/types/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./panel-element": {
      "types": "./dist/types/panel-element.d.ts",
      "import": "./dist/panel-element.js"
    },
    "./standalone": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/filter.standalone.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/*.standalone.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --mode standalone && vite build --mode standalone-panel && npm run types && npm run size",
    "types": "tsc -p tsconfig.build.json && node ../../scripts/fix-types.mjs",
    "size": "node ../../scripts/size.mjs dist/filter.standalone.js=20480 dist/filter-panel.standalone.js=20480",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "lit": "^3.3.3"
  }
}
